# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL
POSTGRES_DB=webrtc
POSTGRES_USER=webrtc
POSTGRES_PASSWORD=change-me-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# WebSocket transport
PROTOCOL_RATE_LIMIT_MESSAGES_PER_MINUTE=60
WEBSOCKET_HEARTBEAT_INTERVAL_SECONDS=30
WEBSOCKET_HEARTBEAT_TIMEOUT_SECONDS=90
WEBSOCKET_MAX_MESSAGE_BYTES=65536
