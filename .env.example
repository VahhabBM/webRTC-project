# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL
POSTGRES_DB=webrtc
POSTGRES_USER=webrtc
POSTGRES_PASSWORD=change-me-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# WebSocket transport
PROTOCOL_RATE_LIMIT_MESSAGES_PER_MINUTE=60
WEBSOCKET_HEARTBEAT_INTERVAL_SECONDS=30
WEBSOCKET_HEARTBEAT_TIMEOUT_SECONDS=90
# Seconds before Round.ends_at at which T-24 sends server.round_warning.
ORCHESTRATOR_FINAL_SECONDS=30

# T-38: leave empty in normal use. Set to one Pair.room_id (e.g. test-room-101)
# to allow primary/direct → relay fallback for that pair only.
MEDIA_FALLBACK_ROOM_ID=

# T-39: milliseconds to wait for the primary/direct path before escalating
# THIS pair to the T-38 fallback. Default lives in protocol (do not scatter).
MEDIA_FALLBACK_ESCALATION_TIMEOUT_MS=6000
